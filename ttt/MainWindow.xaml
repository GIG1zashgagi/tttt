<Window x:Class="ttt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RSA Шифратор - Практическая работа №7"
        Height="550" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="RSA Шифрование / Дешифрование" 
FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" 
Margin="0,0,0,15" Foreground="Black"/>
        <GroupBox Grid.Row="1" Header="1. Генерация ключей" Margin="0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <TextBlock Text="p:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
                <TextBox x:Name="txtP" Text="17" Width="80" Grid.Row="0" Grid.Column="1"/>

                <TextBlock Text="q:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="2"/>
                <TextBox x:Name="txtQ" Text="19" Width="80" Grid.Row="0" Grid.Column="3"/>

                <Button x:Name="btnGenerateKeys" Content="Сгенерировать ключи" 
     Click="BtnGenerateKeys_Click" Width="130" Grid.Row="0" Grid.Column="4"/>

                <TextBlock Text="e (public):" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
                <TextBox x:Name="txtPublicKey" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" 
      IsReadOnly="True" Background="#F0F0F0" Margin="0,2"/>

                <TextBlock Text="d (private):" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/>
                <TextBox x:Name="txtPrivateKey" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" 
      IsReadOnly="True" Background="#F0F0F0" Margin="0,2"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="2. Шифрование" Margin="0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="txtInput" Height="80" TextWrapping="Wrap" 
      AcceptsReturn="True" Margin="0,0,0,5" Grid.Row="0"
      VerticalScrollBarVisibility="Auto"/>

                <StackPanel Orientation="Horizontal" Grid.Row="1">
                    <Button x:Name="btnEncrypt" Content="➡ Зашифровать" Click="BtnEncrypt_Click" 
         Width="100" Margin="0,0,10,0" Background="Gray" Foreground="White"/>
                    <TextBox x:Name="txtOutput" Height="60" TextWrapping="Wrap" 
          AcceptsReturn="True" Width="450" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="3. Дешифрование" Margin="0,5">
            <StackPanel>
                <Button x:Name="btnDecrypt" Content="⬅ Расшифровать" Click="BtnDecrypt_Click" 
     Width="100" Margin="0,0,0,5" Background="Gray" Foreground="White"/>
                <TextBox x:Name="txtDecrypted" Height="80" TextWrapping="Wrap" 
      IsReadOnly="True" Background="#F5F5F5" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Grid.Row="4" Header="4. Управление" Margin="0,5">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnClear" Content="Очистить всё" Click="BtnClear_Click" 
     Width="100" Margin="0,0,10,0"/>
                <TextBlock x:Name="lblStatus" Text="Готово" VerticalAlignment="Center" 
        Foreground="Gray" FontWeight="SemiBold"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>